# Copy to .env (same folder). Required for Expo Go on a physical phone.
#
# Use your PC LAN IP — NOT localhost (phone cannot reach 127.0.0.1 on your PC).
# Windows: ipconfig → IPv4 Address (e.g. 192.168.31.232)
# Backend must listen on 0.0.0.0:3000 (npm run start:dev in ../backend)
#
EXPO_PUBLIC_API_URL=http://192.168.31.232:3000
